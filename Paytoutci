const express = require('express');
const axios = require('axios');
const app = express();

app.use(express.json());
app.use(express.static('public'));

let transfers = [];

app.post('/transfer', async (req, res) => {
  const { fromNum, toNum, to, amount } = req.body;
  const montant = parseInt(amount);
  if (!montant || montant < 100) return res.json({ error: "Montant minimum 100F" });

  const frais = Math.round(montant * 0.05);
  const total = montant + frais;
  const transaction_id = "PAYTOUT-" + Date.now();

  try {
    const response = await axios.post('https://api-checkout.cinetpay.com/v2/payment', {
      apikey: process.env.CINETPAY_APIKEY,
      site_id: process.env.CINETPAY_SITE_ID,
      transaction_id: transaction_id,
      amount: total,
      currency: 'XOF',
      description: `Transfert ${montant}F vers ${to} ${toNum}`,
      customer_phone_number: fromNum,
      notify_url: `https://${req.get('host')}/notify`,
      return_url: `https://${req.get('host')}/`,
      channels: "WALLET",
    });

    transfers.push({ id: transaction_id, date: new Date(), from: fromNum, to: toNum, operateur: to, montant, frais, total, status: 'En attente paiement' });

    return res.json({ success: true, payment_url: response.data.data.payment_url, message: `Redirection vers paiement de ${total}F` });

  } catch (e) {
    console.error(e.response?.data || e.message);
    return res.json({ error: "Erreur CinetPay: " + JSON.stringify(e.response?.data || e.message).substring(0,200) });
  }
});

app.get('/transfers', (req, res) => res.json(transfers));
app.post('/notify', (req, res) => { console.log("NOTIFY", req.body); res.sendStatus(200); });

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log("PayTout live sur port", PORT));
